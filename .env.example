# cp .env.example .env

# 2025.x or newer is REQUIRED: the load path uses Cypher's built-in
# coll.distinct(), which does not exist in 5.x. On 5.x, swap it back to
# apoc.coll.toSet() in loader/src/codekg/db.py and cypher/10_link_cross_repo.cypher.
NEO4J_IMAGE=neo4j:2026.07-enterprise
NEO4J_PASSWORD=codekgcodekg
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Corpus A fits comfortably in these. Corpus B with loki + tempo (--full) wants
# 8G heap and 4G pagecache, and Docker Desktop needs to be allowed that much.
NEO4J_HEAP=4G
NEO4J_PAGECACHE=2G

# --- Licenses ----------------------------------------------------------------
# Both are REFERENCED, never copied or committed (.gitignore excludes
# *.license). The harness assumes both sit at the repo root; point these
# elsewhere if yours do not.
#
#   gds.license  - GDS Enterprise. Without it the plugin runs community-tier,
#                  which caps projections and blocks some algorithms.
#   nes.license  - Neo4j Enterprise Studio (Query + Bloom + Dashboards).
GDS_LICENSE_PATH=./gds.license
NES_LICENSE_PATH=./nes.license
NES_PORT=8080
